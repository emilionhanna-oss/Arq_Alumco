<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # Serve real files and directories (JS/CSS bundles, images, etc.) as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is a client-side (React Router) route — always hand it
    # index.html so a hard reload / direct link to e.g. /dashboard doesn't
    # 404 against a path Apache has never heard of.
    RewriteRule ^ index.html [L]
</IfModule>
