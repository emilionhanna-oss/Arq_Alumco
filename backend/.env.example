PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# OBLIGATORIO en producción (el servidor no arranca sin él). Genera uno: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_secreto_largo
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alumco_dev
DB_SSL=false
FRONTEND_URL=http://localhost:5173

# --- Despliegue canario ---
# Versión del artefacto (se ve en /health, /metrics y el header X-App-Version). Por defecto: version de package.json
APP_VERSION=1.0.0
# Rol de esta instancia en el despliegue: stable | canary
APP_TRACK=stable
# Canary por funcionalidad: "flag:porcentaje" separados por coma. 0 = apagado, 100 = todos.
FEATURE_FLAGS=ranking_v2:0
# Opcional: protege GET /metrics con "Authorization: Bearer <token>"
METRICS_TOKEN=
DEMO_PASSWORD=Demo1234!
